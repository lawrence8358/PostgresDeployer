<hc:Window x:Class="PostgresDeployer.Wpf.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:views="clr-namespace:PostgresDeployer.Wpf.Views"
           xmlns:svc="clr-namespace:PostgresDeployer.Wpf.Services"
           xmlns:l="clr-namespace:PostgresDeployer.Wpf.Extensions"
           mc:Ignorable="d"
           Title="{Binding WindowTitle}"
           Icon="Assets/app.ico"
           Height="660" Width="960"
           MinHeight="480" MinWidth="700"
           NonClientAreaBackground="{DynamicResource PrimaryBrush}"
           ShowInTaskbar="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側邊欄 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 應用程式標頭 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="20,18">
                    <StackPanel>
                        <Image Source="Assets/app.ico"
                               Width="32" Height="32"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PostgresDeployer"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{l:Loc App_Subtitle}"
                                   FontSize="10"
                                   Foreground="#AADDE6FF"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部版本資訊（須宣告在填滿剩餘空間的元素之前） -->
                <TextBlock x:Name="VersionTextBlock"
                           DockPanel.Dock="Bottom"
                           FontSize="10"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="12,0,12,10"/>

                <!-- 語系切換器（位於版本資訊上方） -->
                <ComboBox x:Name="LanguageComboBox"
                          DockPanel.Dock="Bottom"
                          Margin="12,0,12,6"
                          Height="30"
                          ItemsSource="{x:Static svc:LocalizationService.SupportedLanguages}"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 導覽選單（填滿剩餘空間） -->
                <StackPanel Margin="12,16,12,0">
                    <RadioButton x:Name="NavSettings"
                                 Content="{l:Loc Nav_Settings}"
                                 IsChecked="True"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Settings"/>
                    <RadioButton x:Name="NavDeploy"
                                 Content="{l:Loc Nav_Deploy}"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Deploy"
                                 Margin="0,4,0,0"/>
                    <RadioButton x:Name="NavLog"
                                 Content="{l:Loc Nav_Log}"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Log"
                                 Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右側內容區域 -->
        <Border Grid.Column="1" Background="{DynamicResource RegionBrush}">
            <ContentControl x:Name="MainContent">
                <ContentControl.Resources>
                    <views:SettingsView x:Key="SettingsPage" DataContext="{Binding Settings}"/>
                    <views:DeployView   x:Key="DeployPage"   DataContext="{Binding Deploy}"/>
                    <views:LogView      x:Key="LogPage"      DataContext="{Binding Log}"/>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</hc:Window>
