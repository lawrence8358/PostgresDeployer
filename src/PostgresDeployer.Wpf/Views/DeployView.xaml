<UserControl x:Class="PostgresDeployer.Wpf.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:PostgresDeployer.Wpf.Converters"
             xmlns:l="clr-namespace:PostgresDeployer.Wpf.Extensions"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ChangeTypeToColorConverter x:Key="ChangeTypeToColor"/>
        <converters:BoolToVisibilityConverter  x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">

        <!-- 頁面標題列 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{l:Loc Deploy_Title}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center"/>

            <!-- 操作按鈕 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{l:Loc Deploy_Analyze}"
                        Command="{Binding AnalyzeCommand}"
                        Padding="16,0" Height="36" Margin="0,0,8,0"/>
                <Button Content="{l:Loc Deploy_Execute}"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding DeployCommand}"
                        Padding="16,0" Height="36"
                        IsEnabled="{Binding CanDeploy}"
                        Margin="0,0,8,0"/>
                <Button Content="{l:Loc Deploy_Cancel}"
                        Style="{StaticResource ButtonDanger}"
                        Command="{Binding CancelDeployCommand}"
                        Padding="16,0" Height="36"
                        Visibility="{Binding IsDeploying, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>

        <!-- 底部進度卡片 -->
        <hc:Card DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
                <ProgressBar Value="{Binding ProgressValue}"
                             Minimum="0" Maximum="100"
                             Height="10"
                             Style="{StaticResource ProgressBarSuccess}"
                             Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </hc:Card>

        <!-- 主內容：左側變更清單 + 右側 SQL 預覽 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- 變更清單 Card -->
            <hc:Card Grid.Column="0" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4,4,0,0"
                            Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{l:Loc Deploy_ChangeList}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>

                    <TreeView ItemsSource="{Binding ChangeGroups}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              BorderThickness="0"
                              Padding="4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                <!-- GroupType drives the color; GroupName is the localized display text -->
                                <TextBlock Foreground="{Binding GroupType, Converter={StaticResource ChangeTypeToColor}}"
                                           FontWeight="SemiBold" Padding="2,2">
                                    <Run Text="{Binding GroupName, Mode=OneWay}"/>
                                    <Run Text=" (" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <Run Text=")" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </TextBlock>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{Binding Type, Converter={StaticResource ChangeTypeToColor}}"
                                                   Padding="2,1"/>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </hc:Card>

            <!-- 分隔條 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <!-- SQL 預覽 Card -->
            <hc:Card Grid.Column="2" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4,4,0,0"
                            Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{l:Loc Deploy_SqlPreview}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>

                    <TextBox Text="{Binding SelectedSql, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="12"
                             AcceptsReturn="True"
                             Background="{DynamicResource RegionBrush}"
                             BorderThickness="0"
                             Padding="12"/>
                </DockPanel>
            </hc:Card>
        </Grid>
    </DockPanel>
</UserControl>
